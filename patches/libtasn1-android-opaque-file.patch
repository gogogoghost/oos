From 9f0a91cd1bb88a81a2a4d4eb9b3d1bef151cc023 Mon Sep 17 00:00:00 2001
From: OOS <oos@example.invalid>
Date: Mon, 27 Jul 2026 00:00:00 +0800
Subject: [PATCH] libtasn1: avoid private FILE layout without ftello

Android API 23 has no ftello and modern NDKs keep Bionic's FILE layout
opaque. The gnulib implementation already maps ftello to public ftell in this
configuration, so it does not need stdio-impl.h.

---
 gl/ftello.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/gl/ftello.c b/gl/ftello.c
index d788b93..e2bcaa1 100644
--- a/gl/ftello.c
+++ b/gl/ftello.c
@@ -23,7 +23,9 @@
 /* Get lseek.  */
 #include <unistd.h>
 
+#if HAVE_FTELLO
 #include "stdio-impl.h"
+#endif
 
 off_t
 ftello (FILE *fp)
