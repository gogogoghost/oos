{
  "name": "@oos/vite-plugin",
  "version": "0.3.0",
  "description": "Vite build plugin for Solid applications targeting the Orange OS QuickJS runtime",
  "keywords": [
    "oos",
    "quickjs",
    "solid-js",
    "vite"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogogoghost/oos.git",
    "directory": "sdk/js-vite-plugin"
  },
  "homepage": "https://github.com/gogogoghost/oos/tree/main/sdk/js-vite-plugin",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "vite-plugin-solid": "2.11.13"
  },
  "peerDependencies": {
    "@oos/platform": "^0.3.0",
    "solid-js": "^1.9.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@oos/platform": "file:../js",
    "@types/node": "26.1.2",
    "solid-js": "1.9.14",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
