package oos:platform@0.1.0;

interface types {
  enum error-code {
    unavailable,
    invalid-argument,
    permission-denied,
    limit-exceeded,
    io,
    timeout,
    busy,
    failed,
  }

  record size {
    width: u32,
    height: u32,
  }

  record point {
    x: u32,
    y: u32,
  }
}

/// Runtime services available to every OOS application. ABI discovery and the
/// precise clocks are immutable and may be called from the bounded guest
/// worker. Other calls remain lifecycle-thread-only unless documented.
interface runtime {
  use types.{error-code};

  enum log-level {
    debug,
    info,
    warn,
    error,
  }

  enum status-bar-icon-theme {
    light,
    dark,
  }

  enum surface-mode {
    normal,
    immersive,
  }

  abi-version: func() -> u32;
  wall-clock-minutes: func() -> u32;
  /// Monotonic boot-relative time. Legal from the guest worker.
  monotonic-time-us: func() -> u64;
  /// Unix epoch time with millisecond precision. Legal from the guest worker.
  wall-clock-time-ms: func() -> s64;
  /// Wakes the lifecycle thread after publishing work to a shared command
  /// queue. Legal from the guest worker and coalesced by the host.
  wake-main-thread: func();
  log: func(level: log-level, message: string);
  /// Sets this application's retained status-bar appearance. Only the active
  /// application's value is applied. `background-rgb` is 0x00RRGGBB.
  set-status-bar-style: func(
    background-rgb: u32,
    icons: status-bar-icon-theme,
  ) -> result<_, error-code>;
  /// Changes the application layer between status-bar-safe and physical-screen
  /// geometry. The new size is visible immediately through graphics.
  set-surface-mode: func(mode: surface-mode) -> result<_, error-code>;
  /// Requests destruction after the current host or lifecycle call returns.
  request-exit: func() -> result<_, error-code>;
}

/// Retained texture and indexed-triangle drawing for the application surface.
interface graphics {
  use types.{error-code, point, size};

  /// Texture storage and upload formats. Alpha-bearing color formats contain
  /// premultiplied color. Packed 16-bit values use little-endian byte order.
  enum texture-format {
    a8,
    rgb565,
    rgba4444,
    rgba8888,
  }

  flags texture-flags {
    linear-minification,
    linear-magnification,
    replace,
    repeat-x,
    repeat-y,
    mirrored-repeat-x,
    mirrored-repeat-y,
    mipmaps,
    linear-mipmaps,
  }

  record limits {
    max-texture-size: u32,
    max-texture-bytes: u32,
    max-vertices: u32,
    max-indices: u32,
    max-draw-commands: u32,
  }

  /// Premultiplied RGBA vertex. Its canonical memory layout is 20 bytes.
  record vertex {
    position-x: f32,
    position-y: f32,
    uv-x: f32,
    uv-y: f32,
    red: u8,
    green: u8,
    blue: u8,
    alpha: u8,
  }

  /// Indexed draw command. Its canonical memory layout is 28 bytes.
  record draw-command {
    first-index: u32,
    index-count: u32,
    texture: u32,
    clip-min-x: f32,
    clip-min-y: f32,
    clip-max-x: f32,
    clip-max-y: f32,
  }

  surface-size: func() -> size;
  /// Logical-to-physical scale for GUI coordinates. Draw vertices and clip
  /// rectangles submitted to this interface use physical surface pixels.
  pixels-per-point: func() -> f32;
  surface-format: func() -> texture-format;
  /// Bit N reports support for texture-format discriminant N.
  supported-texture-formats: func() -> u32;
  graphics-limits: func() -> limits;
  texture-set: func(
    texture: u32,
    format: texture-format,
    position: point,
    dimensions: size,
    /// Source bytes between consecutive rows. This may exceed the packed row
    /// size; the host uploads strided rows without repacking them.
    row-stride: u32,
    options: texture-flags,
    pixels: list<u8>,
  ) -> result<_, error-code>;
  texture-free: func(texture: u32) -> result<_, error-code>;
  submit: func(
    vertices: list<vertex>,
    indices: list<u16>,
    commands: list<draw-command>,
    clear-rgba: u32,
  ) -> result<_, error-code>;
}

/// A validated, batched OpenGL ES 2.0 programmable pipeline. Resources and
/// commands are scoped to one application. The host owns the EGL context,
/// render target, composition, and presentation; applications never receive
/// native GL, framebuffer, or display handles.
interface gles {
  use types.{error-code};

  enum buffer-usage {
    static-draw,
    dynamic-draw,
    stream-draw,
  }

  enum shader-stage {
    vertex,
    fragment,
  }

  enum command-opcode {
    begin-frame,
    viewport,
    scissor,
    blend,
    depth,
    color-mask,
    stencil,
    stencil-function,
    stencil-operation,
    raster,
    cull,
    use-program,
    bind-texture,
    bind-vertex-buffer,
    bind-index-buffer,
    vertex-attribute,
    uniform,
    draw-arrays,
    draw-elements,
    end-frame,
  }

  enum primitive {
    points,
    lines,
    line-strip,
    triangles,
    triangle-strip,
    triangle-fan,
  }

  enum vertex-type {
    float32,
    uint8,
    sint8,
    uint16,
    sint16,
  }

  enum blend-factor {
    zero,
    one,
    src-color,
    one-minus-src-color,
    dst-color,
    one-minus-dst-color,
    src-alpha,
    one-minus-src-alpha,
    dst-alpha,
    one-minus-dst-alpha,
    constant-color,
    one-minus-constant-color,
    constant-alpha,
    one-minus-constant-alpha,
    src-alpha-saturate,
  }

  enum blend-equation {
    add,
    subtract,
    reverse-subtract,
  }

  enum compare-function {
    never,
    less,
    equal,
    less-equal,
    greater,
    not-equal,
    greater-equal,
    always,
  }

  enum cull-face {
    front,
    back,
    front-and-back,
  }

  enum front-face {
    counter-clockwise,
    clockwise,
  }

  enum stencil-operation {
    keep,
    zero,
    replace,
    increment-clamp,
    decrement-clamp,
    invert,
    increment-wrap,
    decrement-wrap,
  }

  enum uniform-type {
    i1,
    f1,
    f2,
    f3,
    f4,
    mat2,
    mat3,
    mat4,
  }

  record capabilities {
    major-version: u32,
    minor-version: u32,
    max-texture-size: u32,
    max-texture-units: u32,
    max-vertex-attributes: u32,
    max-varying-vectors: u32,
    max-vertex-uniform-vectors: u32,
    max-fragment-uniform-vectors: u32,
    depth-bits: u32,
    stencil-bits: u32,
    max-buffer-bytes: u32,
    max-commands: u32,
    max-command-data-words: u32,
  }

  /// Fixed 36-byte command. `opcode` and arguments use the constants exposed
  /// by each language SDK. Float arguments are their IEEE-754 bit patterns.
  /// Uniform commands address the separate, naturally aligned submit data
  /// list by u32 word offset. Floating-point values use their IEEE-754 bits.
  record command {
    opcode: command-opcode,
    a0: u32,
    a1: u32,
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
  }

  get-capabilities: func() -> capabilities;
  buffer-set: func(
    buffer: u32,
    size: u32,
    usage: buffer-usage,
    initial-data: list<u8>,
  ) -> result<_, error-code>;
  buffer-write: func(
    buffer: u32,
    offset: u32,
    data: list<u8>,
  ) -> result<_, error-code>;
  buffer-free: func(buffer: u32) -> result<_, error-code>;
  shader-set: func(
    shader: u32,
    stage: shader-stage,
    source: string,
  ) -> result<_, error-code>;
  shader-free: func(shader: u32) -> result<_, error-code>;
  program-set: func(
    program: u32,
    vertex-shader: u32,
    fragment-shader: u32,
  ) -> result<_, error-code>;
  program-free: func(program: u32) -> result<_, error-code>;
  attribute-location: func(program: u32, name: string) -> s32;
  uniform-location: func(program: u32, name: string) -> s32;
  submit: func(
    commands: list<command>,
    data: list<u32>,
  ) -> result<_, error-code>;
}

/// Static device identity and capability discovery. Applications must query a
/// capability before using the corresponding optional service interface.
interface device {
  enum feature {
    primary-display,
    secondary-display,
    key-input,
    audio-playback,
    audio-capture,
    camera-capture,
    torch,
    vibration,
    battery,
    suspend,
    rtc-wake,
    wifi,
    ip-configuration,
    bluetooth-classic,
    bluetooth-low-energy,
    modem,
    hardware-video-codec,
    location,
    sensors,
    fm-radio,
    nfc,
  }

  enum capability-state {
    unsupported,
    planned,
    implemented,
    validated,
  }

  record descriptor {
    id: string,
    manufacturer: string,
    model: string,
    android-api: u32,
    primary-width: u32,
    primary-height: u32,
    secondary-width: u32,
    secondary-height: u32,
  }

  get-descriptor: func() -> descriptor;
  get-capability: func(feature: feature) -> capability-state;
}

interface audio {
  use types.{error-code};

  enum decoder-kind {
    built-in,
    platform,
  }

  /// One format that this OOS build can actually decode. MIME type is the
  /// stable identifier; the comma-separated extensions are discovery hints.
  record format-support {
    mime-type: string,
    extensions: string,
    decoder: decoder-kind,
    streaming: bool,
    seekable: bool,
  }

  enum usage {
    media,
    voice,
    ringtone,
    alarm,
    notification,
  }

  record stream-info {
    sample-rate: s32,
    channel-count: s32,
    device-id: s32,
    frames-transferred: s64,
  }

  record recording-result {
    audio-stream: stream-info,
    peak: f64,
    rms: f64,
    path: string,
  }

  record opened-pcm {
    handle: u32,
    audio-stream: stream-info,
  }

  record pcm-capabilities {
    minimum-sample-rate: u32,
    maximum-sample-rate: u32,
    supported-channel-mask: u32,
    minimum-capacity-frames: u32,
    maximum-capacity-frames: u32,
  }

  record pcm-stream-status {
    audio-stream: stream-info,
    queued-frames: s64,
    consumed-frames: s64,
    underruns: s32,
    paused: bool,
  }

  enum player-state {
    preparing,
    ready,
    playing,
    paused,
    ended,
    failed,
  }

  enum media-failure {
    none,
    unsupported-format,
    malformed-data,
    resource-exhaustion,
    io,
    decoder,
  }

  record source-limits {
    maximum-source-bytes: u64,
    maximum-session-bytes: u64,
    maximum-sources: u32,
    maximum-players: u32,
  }

  record playback-status {
    state: player-state,
    position-ms: u64,
    duration-ms: u64,
    underruns: s32,
    failure: media-failure,
  }

  supported-formats: func() -> list<format-support>;
  get-pcm-capabilities: func() -> pcm-capabilities;
  get-source-limits: func() -> source-limits;

  /// Opens a persistent, bounded signed-S16 interleaved output stream.
  pcm-open: func(
    sample-rate: u32,
    channel-count: u32,
    capacity-frames: u32,
    usage: usage,
  ) -> result<opened-pcm, error-code>;
  /// Non-blocking write. The result is the number of whole frames accepted.
  pcm-write: func(handle: u32, samples: list<s16>) -> result<u64, error-code>;
  pcm-set-volume: func(handle: u32, volume: f32) -> result<_, error-code>;
  pcm-pause: func(handle: u32) -> result<_, error-code>;
  pcm-resume: func(handle: u32) -> result<_, error-code>;
  pcm-flush: func(handle: u32) -> result<_, error-code>;
  pcm-status: func(handle: u32) -> result<pcm-stream-status, error-code>;
  pcm-close: func(handle: u32) -> result<_, error-code>;

  /// Creates an asynchronous player for a file under the package's assets/.
  player-open-asset: func(path: string, usage: usage) -> result<u32, error-code>;
  /// Copies guest-owned encoded media once into an immutable, session-owned
  /// source. Empty MIME and locator strings request bounded content sniffing.
  source-create: func(
    bytes: list<u8>,
    mime-type: string,
    locator-hint: string,
  ) -> result<u32, error-code>;
  source-close: func(handle: u32) -> result<_, error-code>;
  player-open-source: func(source: u32, usage: usage) -> result<u32, error-code>;
  player-play: func(handle: u32) -> result<_, error-code>;
  player-pause: func(handle: u32) -> result<_, error-code>;
  player-seek: func(handle: u32, position-ms: u64) -> result<_, error-code>;
  player-set-volume: func(handle: u32, volume: f32) -> result<_, error-code>;
  player-set-looping: func(handle: u32, looping: bool) -> result<_, error-code>;
  player-status: func(handle: u32) -> result<playback-status, error-code>;
  player-close: func(handle: u32) -> result<_, error-code>;

  play-tone: func(
    frequency-hz: f64,
    duration-ms: u32,
    volume: f32,
    usage: usage,
  ) -> result<stream-info, error-code>;
  record-wav: func(path: string, duration-ms: u32) -> result<recording-result, error-code>;
  last-error: func() -> string;
}

/// One ephemeral child module owned by the calling application session.
/// Compiler and game-runtime modules use independent linear memories so
/// destruction deterministically returns their committed pages to OOS.
interface subruntime {
  use types.{error-code};

  enum child-state {
    loading,
    running,
    completed,
    exit-requested,
    failed,
    cancelled,
  }

  record child-status {
    state: child-state,
    next-frame-delay-ms: u32,
    result-code: u32,
  }

  record limits {
    maximum-instances: u32,
    minimum-stack-bytes: u32,
    maximum-stack-bytes: u32,
    effective-worker-stack-bytes: u32,
    maximum-memory-bytes: u64,
  }

  get-limits: func() -> limits;
  /// `module` is a simple name resolved as modules/<name>.aot, then .wasm.
  create: func(
    module: string,
    main-stack-bytes: u32,
  ) -> result<u32, error-code>;
  initialize: func(handle: u32) -> result<_, error-code>;
  event: func(handle: u32, code: u32, action: u32, monotonic-time-us: u64) -> result<_, error-code>;
  frame: func(handle: u32, monotonic-time-us: u64) -> result<u32, error-code>;
  status: func(handle: u32) -> result<child-status, error-code>;
  /// Called by a packaged child after it has durably committed its result.
  complete: func(result-code: u32) -> result<_, error-code>;
  destroy: func(handle: u32) -> result<_, error-code>;
  last-error: func() -> string;
}

interface camera {
  use types.{error-code};

  enum lens-facing {
    unknown,
    front,
    back,
    external,
  }

  record info {
    id: string,
    facing: lens-facing,
    sensor-orientation: s32,
    hardware-level: s32,
    flash-available: bool,
    max-jpeg-width: s32,
    max-jpeg-height: s32,
  }

  record photo-result {
    path: string,
    width: s32,
    height: s32,
    bytes: u64,
  }

  enumerate: func() -> result<list<info>, error-code>;
  set-torch: func(camera-id: string, enabled: bool) -> result<_, error-code>;
  capture-jpeg: func(
    camera-id: string,
    path: string,
    width: s32,
    height: s32,
    flash: bool,
    timeout-ms: u32,
  ) -> result<photo-result, error-code>;
  last-error: func() -> string;
}

interface power {
  use types.{error-code};

  enum battery-state {
    unknown,
    charging,
    discharging,
    not-charging,
    full,
  }

  enum flip-state {
    unknown,
    open,
    closed,
  }

  record battery-snapshot {
    state: battery-state,
    capacity-percent: s32,
    voltage-microvolts: s32,
    current-microamps: s32,
    temperature-tenths-celsius: s32,
    usb-online: bool,
  }

  query-battery: func() -> result<battery-snapshot, error-code>;
  wait-for-battery-event: func(timeout-ms: u32) -> result<option<battery-snapshot>, error-code>;
  set-interactive: func(interactive: bool) -> result<_, error-code>;
  acquire-wake-lock: func(name: string) -> result<_, error-code>;
  release-wake-lock: func(name: string) -> result<_, error-code>;
  enable-auto-suspend: func() -> result<_, error-code>;
  disable-auto-suspend: func() -> result<_, error-code>;
  schedule-rtc-wake: func(delay-seconds: u32) -> result<_, error-code>;
  clear-rtc-wake: func() -> result<_, error-code>;
  suspend: func(graceful-timeout-ms: u32) -> result<_, error-code>;
  query-flip-state: func() -> result<flip-state, error-code>;
  last-error: func() -> string;
}

interface vibrator {
  use types.{error-code};

  vibrate: func(duration-ms: u32) -> result<_, error-code>;
  stop: func() -> result<_, error-code>;
  supports-amplitude-control: func() -> bool;
  set-amplitude: func(amplitude: u8) -> result<_, error-code>;
  last-error: func() -> string;
}

interface wifi {
  use types.{error-code};

  enum security {
    open,
    wpa-psk,
  }

  record status {
    state: string,
    ssid: string,
    bssid: string,
    ip-address: string,
    network-id: s32,
  }

  record access-point {
    bssid: string,
    frequency-mhz: s32,
    signal-dbm: s32,
    capabilities: string,
    ssid: string,
  }

  record network {
    id: s32,
    ssid: string,
    bssid: string,
    capabilities: string,
  }

  get-status: func() -> result<status, error-code>;
  scan: func(wait-ms: u32) -> result<list<access-point>, error-code>;
  list-networks: func() -> result<list<network>, error-code>;
  connect: func(ssid: string, security: security, credential: string) -> result<s32, error-code>;
  disconnect: func() -> result<_, error-code>;
  reconnect: func() -> result<_, error-code>;
  forget: func(network-id: s32) -> result<_, error-code>;
  save-configuration: func() -> result<_, error-code>;
  last-error: func() -> string;
}

interface ip {
  use types.{error-code};

  record configuration {
    interface-name: string,
    address: string,
    prefix-length: u32,
    gateway: string,
    dns1: string,
    dns2: string,
  }

  get-status: func() -> result<configuration, error-code>;
  use-dhcp: func(timeout-ms: u32) -> result<_, error-code>;
  use-static: func(configuration: configuration) -> result<_, error-code>;
  last-error: func() -> string;
}

interface bluetooth {
  use types.{error-code};

  enum transport {
    auto,
    classic,
    low-energy,
  }

  enum profile {
    hid,
    hands-free,
    a2dp,
  }

  record discovered-device {
    address: string,
    name: string,
    rssi: s32,
    device-class: u32,
    device-type: s32,
    advertising-data: list<u8>,
  }

  enable: func(timeout-ms: u32) -> result<_, error-code>;
  disable: func(timeout-ms: u32) -> result<_, error-code>;
  classic-scan: func(duration-ms: u32) -> result<list<discovered-device>, error-code>;
  le-scan: func(duration-ms: u32) -> result<list<discovered-device>, error-code>;
  pair: func(address: string, transport: transport) -> result<_, error-code>;
  unpair: func(address: string) -> result<_, error-code>;
  cancel-pairing: func(address: string) -> result<_, error-code>;
  profile-connect: func(address: string, profile: profile) -> result<_, error-code>;
  profile-disconnect: func(address: string, profile: profile) -> result<_, error-code>;
  profile-connection-cycle: func(
    address: string,
    profile: profile,
    hold-ms: u32,
  ) -> result<_, error-code>;
  le-connection-cycle: func(address: string, hold-ms: u32, timeout-ms: u32) -> result<_, error-code>;
  last-error: func() -> string;
}

interface modem {
  use types.{error-code};

  record request-status {
    operation: string,
    error: s32,
    timed-out: bool,
  }

  record sim-status {
    card-state: s32,
    universal-pin-state: s32,
    application-count: s32,
  }

  record device-identity {
    imei: string,
    imei-software-version: string,
    esn: string,
    meid: string,
  }

  record signal-status {
    gsm-strength: s32,
    gsm-bit-error-rate: s32,
    cdma-dbm: s32,
    cdma-ecio: s32,
    evdo-dbm: s32,
    evdo-ecio: s32,
    evdo-snr: s32,
    lte-strength: s32,
    lte-rsrp: s32,
    lte-rsrq: s32,
    lte-rssnr: s32,
    lte-cqi: s32,
    lte-timing-advance: s32,
    tdscdma-rscp: s32,
  }

  record registration-status {
    state: s32,
    radio-technology: s32,
    denial-reason: s32,
    max-data-calls: s32,
  }

  record operator-status {
    long-name: string,
    short-name: string,
    numeric: string,
  }

  record snapshot {
    service-connected: bool,
    radio-state: s32,
    baseband-version: string,
    identity: device-identity,
    sim: sim-status,
    signal: signal-status,
    voice-registration: registration-status,
    data-registration: registration-status,
    network-operator: operator-status,
    preferred-network-type: s32,
    voice-radio-technology: s32,
    current-call-count: s32,
    data-call-count: s32,
    hardware-config-count: s32,
    radio-access-family: u32,
    logical-modem-uuid: string,
    requests: list<request-status>,
  }

  query-snapshot: func(timeout-ms: u32) -> result<snapshot, error-code>;
  set-radio-power: func(enabled: bool, timeout-ms: u32) -> result<request-status, error-code>;
  last-error: func() -> string;
}

interface codec {
  use types.{error-code};

  record round-trip-result {
    encoder-name: string,
    decoder-name: string,
    encoder-hardware-accelerated: bool,
    decoder-hardware-accelerated: bool,
    width: s32,
    height: s32,
    input-frames: s32,
    output-buffers: s32,
    decoded-frames: s32,
    encoded-bytes: u64,
  }

  test-h264-round-trip: func(
    width: s32,
    height: s32,
    frame-count: s32,
    timeout-ms: u32,
  ) -> result<round-trip-result, error-code>;
  last-error: func() -> string;
}

/// Per-application persistent storage. The host selects the backing directory
/// from the application registry; guests never receive a filesystem path.
interface storage {
  use types.{error-code};

  enum row-state {
    row,
    done,
  }

  enum value-kind {
    integer,
    float,
    text,
    blob,
    null,
  }

  kv-get: func(key: string) -> result<option<list<u8>>, error-code>;
  kv-set: func(key: string, value: list<u8>) -> result<_, error-code>;
  kv-delete: func(key: string) -> result<_, error-code>;
  kv-clear: func() -> result<_, error-code>;

  database-execute: func(database: string, sql: string) -> result<u32, error-code>;
  database-prepare: func(database: string, sql: string) -> result<u32, error-code>;
  statement-bind-null: func(statement: u32, index: u32) -> result<_, error-code>;
  statement-bind-integer: func(statement: u32, index: u32, value: s64) -> result<_, error-code>;
  statement-bind-float: func(statement: u32, index: u32, value: f64) -> result<_, error-code>;
  statement-bind-text: func(statement: u32, index: u32, value: string) -> result<_, error-code>;
  statement-bind-blob: func(statement: u32, index: u32, value: list<u8>) -> result<_, error-code>;
  statement-step: func(statement: u32) -> result<row-state, error-code>;
  statement-column-count: func(statement: u32) -> result<u32, error-code>;
  statement-column-kind: func(statement: u32, column: u32) -> result<value-kind, error-code>;
  statement-column-integer: func(statement: u32, column: u32) -> result<s64, error-code>;
  statement-column-float: func(statement: u32, column: u32) -> result<f64, error-code>;
  statement-column-text: func(statement: u32, column: u32) -> result<string, error-code>;
  statement-column-blob: func(statement: u32, column: u32) -> result<list<u8>, error-code>;
  statement-finish: func(statement: u32) -> result<_, error-code>;
}

/// User-visible files on internal and removable media. This is distinct from
/// application-private KV/SQLite storage: paths are relative to a selected
/// volume and the host retains ownership of the underlying filesystem.
interface device-storage {
  use types.{error-code};

  enum volume {
    internal,
    removable,
  }

  enum write-mode {
    /// Create a new file and fail if the path already exists.
    create,
    /// Atomically replace the complete file contents.
    replace,
    /// Append to an existing file, creating it when absent.
    append,
  }

  record entry {
    path: string,
    size: u64,
    last-modified-ms: s64,
  }

  enumerate-files: func(volume: volume) -> result<list<entry>, error-code>;
  read-file: func(volume: volume, path: string) -> result<list<u8>, error-code>;
  write-file: func(
    volume: volume,
    path: string,
    mode: write-mode,
    bytes: list<u8>,
  ) -> result<_, error-code>;
  /// Returns true when a file was removed and false when it did not exist.
  delete-file: func(volume: volume, path: string) -> result<bool, error-code>;
  free-space: func(volume: volume) -> result<u64, error-code>;
  used-space: func(volume: volume) -> result<u64, error-code>;
}

/// Read-only fonts installed by OOS. The returned byte vector owns its Guest
/// allocation and can be moved directly into a GUI framework's font database.
/// Applications may bundle additional fonts when an optional role is absent.
interface font-assets {
  use types.{error-code};

  enum font-role {
    ui-proportional,
    ui-monospace,
    emoji,
    cjk-fallback,
  }

  load: func(role: font-role) -> result<list<u8>, error-code>;
}

/// Read-only files stored below the calling application's package `assets/`
/// directory. Handles and returned bytes are scoped to one application session.
interface assets {
  use types.{error-code};

  record opened-asset {
    handle: u32,
    size: u64,
  }

  open: func(path: string) -> result<opened-asset, error-code>;
  read: func(handle: u32, offset: u64, maximum-bytes: u32) -> result<list<u8>, error-code>;
  close: func(handle: u32) -> result<_, error-code>;
}

// Trusted policy and state broker for SystemUI. Payloads use JSON because the
// managed KaiOS services contain open dictionaries and versioned vendor data.
// Device access is deliberately excluded from this interface.
interface system-services {
  use types.{error-code};

  request: func(
    service: string,
    operation: string,
    payload: string,
  ) -> result<string, error-code>;
}

/// Lifecycle exported by every OOS application.
interface lifecycle {
  use types.{error-code};

  enum key-action {
    released,
    pressed,
    repeated,
  }

  record key-event {
    code: u32,
    action: key-action,
    monotonic-time-us: u64,
  }

  init: func() -> result<_, error-code>;
  event: func(event: key-event);
  /// Returns the maximum delay before the next lifecycle frame. The host may
  /// wake earlier for input, compositor invalidation, or wake-main-thread.
  frame: func(monotonic-time-us: u64) -> result<u32, error-code>;
  shutdown: func();
}

world app {
  import runtime;
  import graphics;
  import gles;
  import device;
  import audio;
  import camera;
  import power;
  import vibrator;
  import wifi;
  import ip;
  import bluetooth;
  import modem;
  import codec;
  import storage;
  import device-storage;
  import font-assets;
  import assets;
  import system-services;
  import subruntime;

  export lifecycle;
}
