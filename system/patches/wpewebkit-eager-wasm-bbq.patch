From 21a76d48da9f8c8c228518f602374516fca13afd Mon Sep 17 00:00:00 2001
From: OOS <oos@example.invalid>
Date: Thu, 30 Jul 2026 08:30:00 +0800
Subject: [PATCH] JSC: optionally compile Wasm modules eagerly with BBQ

ARM32 cannot use the IPInt or OMG tiers. Add an opt-in mode which compiles all
internal functions with BBQ before WebAssembly module instantiation completes.
Compilation failures are reported through the normal CalleeGroup error path.
---
 Source/JavaScriptCore/runtime/OptionsList.h    |  1 +
 Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp |  7 +++
 Source/JavaScriptCore/wasm/WasmCalleeGroup.h   |  2 +
 Source/JavaScriptCore/wasm/WasmModule.cpp      | 54 ++++++++++++++++++-
 Source/JavaScriptCore/wasm/WasmModule.h        |  2 +
 5 files changed, 65 insertions(+), 1 deletion(-)

diff --git a/Source/JavaScriptCore/runtime/OptionsList.h b/Source/JavaScriptCore/runtime/OptionsList.h
index f378e77a22..f934ffa377 100644
--- a/Source/JavaScriptCore/runtime/OptionsList.h
+++ b/Source/JavaScriptCore/runtime/OptionsList.h
@@ -569,6 +569,7 @@ bool hasCapacityToUseLargeGigacage();
     v(Bool, verboseBBQJITInstructions, false, Normal, "Logs instruction information during BBQ JIT"_s) \
     v(Bool, disableBBQConsts, false, Normal, "Wasm <type>.const instructions in BBQ JIT won't lower to a const BBQ::Value"_s) \
     v(Bool, useBBQJIT, true, Normal, "allows the BBQ JIT to be used if true"_s) \
+    v(Bool, useEagerBBQCompilation, false, Normal, "compile all Wasm functions with BBQ before instantiation completes"_s) \
     v(Bool, useOMGJIT, !isARM_THUMB2(), Normal, "allows the OMG JIT to be used if true"_s) \
     v(OptionRange, wasmFunctionIndexRangeToCompile, nullptr, Normal, "wasm function index range to allow compilation on, e.g. 1:100"_s) \
     v(Bool, useEagerWasmModuleHashing, false, Normal, "Unnamed Wasm modules are identified in backtraces through their hash, if available."_s) \
diff --git a/Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp b/Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp
index daf753457b..8596a58383 100644
--- a/Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp
+++ b/Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp
@@ -119,6 +119,13 @@ void CalleeGroup::waitUntilFinished()
     // else, if we don't have a plan, we're already compiled.
 }
 
+void CalleeGroup::failEagerCompilation(String&& errorMessage)
+{
+    Locker locker { m_lock };
+    if (!m_errorMessage)
+        m_errorMessage = WTF::move(errorMessage);
+}
+
 void CalleeGroup::compileAsync(VM& vm, AsyncCompilationCallback&& task)
 {
     RefPtr<Plan> plan;
diff --git a/Source/JavaScriptCore/wasm/WasmCalleeGroup.h b/Source/JavaScriptCore/wasm/WasmCalleeGroup.h
index 9b442bb708..f983bf1c27 100644
--- a/Source/JavaScriptCore/wasm/WasmCalleeGroup.h
+++ b/Source/JavaScriptCore/wasm/WasmCalleeGroup.h
@@ -88,6 +88,8 @@ public:
         return crossThreadCopy(m_errorMessage);
     }
 
+    void failEagerCompilation(String&&);
+
     unsigned functionImportCount() const { return m_wasmToWasmExitStubs.size(); }
     FunctionSpaceIndex toSpaceIndex(FunctionCodeIndex codeIndex) const
     {
diff --git a/Source/JavaScriptCore/wasm/WasmModule.cpp b/Source/JavaScriptCore/wasm/WasmModule.cpp
index c11999498c..e92a12c7b4 100644
--- a/Source/JavaScriptCore/wasm/WasmModule.cpp
+++ b/Source/JavaScriptCore/wasm/WasmModule.cpp
@@ -29,6 +29,7 @@
 #if ENABLE(WEBASSEMBLY)
 
 #include "JSWebAssemblyInstance.h"
+#include "WasmBBQPlan.h"
 #include "WasmDebugServer.h"
 #include "WasmIPIntPlan.h"
 #include "WasmInstanceAnchor.h"
@@ -115,13 +116,64 @@ Ref<CalleeGroup> Module::compileSync(VM& vm, MemoryMode mode)
 {
     Ref<CalleeGroup> calleeGroup = getOrCreateCalleeGroup(vm, mode);
     calleeGroup->waitUntilFinished();
+    eagerlyCompileBBQ(vm, calleeGroup.get());
     return calleeGroup;
 }
 
 void Module::compileAsync(VM& vm, MemoryMode mode, CalleeGroup::AsyncCompilationCallback&& task)
 {
     Ref<CalleeGroup> calleeGroup = getOrCreateCalleeGroup(vm, mode);
-    calleeGroup->compileAsync(vm, WTF::move(task));
+    Ref protectedThis { *this };
+    calleeGroup->compileAsync(vm, createSharedTask<CalleeGroup::CallbackType>([this, protectedThis = WTF::move(protectedThis), task = WTF::move(task), &vm] (Ref<CalleeGroup>&& compiledGroup, bool isAsync) mutable {
+        eagerlyCompileBBQ(vm, compiledGroup.get());
+        task->run(WTF::move(compiledGroup), isAsync);
+    }));
+}
+
+void Module::eagerlyCompileBBQ(VM& vm, CalleeGroup& calleeGroup)
+{
+#if ENABLE(WEBASSEMBLY_BBQJIT)
+    if (!Options::useEagerBBQCompilation() || !calleeGroup.runnable())
+        return;
+
+    Locker eagerLocker { m_eagerCompilationLock };
+    for (uint32_t rawIndex = 0; rawIndex < moduleInformation().internalFunctionCount(); ++rawIndex) {
+        FunctionCodeIndex functionIndex { rawIndex };
+        if (calleeGroup.tryGetReplacementConcurrently(functionIndex))
+            continue;
+
+        Ref<IPIntCallee> profiledCallee = ipintCallees().at(rawIndex);
+        if (!BBQPlan::ensureGlobalBBQAllowlist().containsWasmFunction(functionIndex)
+            || !Options::wasmFunctionIndexRangeToCompile().isInRange(functionIndex)) {
+            calleeGroup.failEagerCompilation(makeString("BBQ compilation is disabled for Wasm function "_s, rawIndex));
+            return;
+        }
+
+        {
+            Locker locker { profiledCallee->tierUpCounter().m_lock };
+            auto status = profiledCallee->tierUpCounter().compilationStatus(calleeGroup.mode());
+            if (status == IPIntTierUpCounter::CompilationStatus::Compiled)
+                continue;
+            if (status != IPIntTierUpCounter::CompilationStatus::NotCompiled) {
+                calleeGroup.failEagerCompilation(makeString("Wasm function "_s, rawIndex, " is already being compiled"_s));
+                return;
+            }
+            profiledCallee->tierUpCounter().setCompilationStatus(calleeGroup.mode(), IPIntTierUpCounter::CompilationStatus::Compiling);
+        }
+
+        Ref<BBQPlan> plan = BBQPlan::create(vm, const_cast<ModuleInformation&>(moduleInformation()), functionIndex,
+            WTF::move(profiledCallee), Ref { *this }, Ref { calleeGroup }, Plan::dontFinalize());
+        plan->work();
+        if (plan->failed()) {
+            calleeGroup.failEagerCompilation(makeString("eager BBQ compilation failed for Wasm function "_s,
+                rawIndex, ": "_s, plan->errorMessage()));
+            return;
+        }
+    }
+#else
+    if (Options::useEagerBBQCompilation())
+        calleeGroup.failEagerCompilation("eager BBQ compilation requires the BBQ JIT"_s);
+#endif
 }
 
 void Module::copyInitialCalleeGroupToAllMemoryModes(MemoryMode initialMode)
diff --git a/Source/JavaScriptCore/wasm/WasmModule.h b/Source/JavaScriptCore/wasm/WasmModule.h
index ee9e230faf..fc689b31be 100644
--- a/Source/JavaScriptCore/wasm/WasmModule.h
+++ b/Source/JavaScriptCore/wasm/WasmModule.h
@@ -98,6 +98,7 @@ public:
 
 private:
     Ref<CalleeGroup> getOrCreateCalleeGroup(VM&, MemoryMode);
+    void eagerlyCompileBBQ(VM&, CalleeGroup&);
 
     Module(IPIntPlan&);
     const Ref<ModuleInformation> m_moduleInformation;
@@ -106,6 +107,7 @@ private:
     FixedVector<MacroAssemblerCodeRef<WasmEntryPtrTag>> m_wasmToJSExitStubs;
     ThreadSafeWeakHashSet<InstanceAnchor> m_anchors;
     Lock m_lock;
+    Lock m_eagerCompilationLock;
 };
 
 } } // namespace JSC::Wasm
