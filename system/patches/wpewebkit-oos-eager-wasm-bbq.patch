 Source/JavaScriptCore/wasm/WasmBBQJIT.cpp         |  2 +-
 Source/JavaScriptCore/wasm/WasmCalleeGroup.cpp    |  7 +++
 Source/JavaScriptCore/wasm/WasmCalleeGroup.h      |  2 +
 Source/JavaScriptCore/wasm/WasmModule.cpp          | 58 +++++++++++++++++++++-
 Source/JavaScriptCore/wasm/WasmModule.h            |  2 +
 6 files changed, 70 insertions(+), 2 deletions(-)

