diff --git a/Source/JavaScriptCore/wasm/WasmModule.cpp b/Source/JavaScriptCore/wasm/WasmModule.cpp
index c11999498c..e92a12c7b4 100644
--- a/Source/JavaScriptCore/wasm/WasmModule.cpp
+++ b/Source/JavaScriptCore/wasm/WasmModule.cpp
@@ -29,6 +29,7 @@
 #if ENABLE(WEBASSEMBLY)
 
 #include "JSWebAssemblyInstance.h"
+#include "WasmBBQPlan.h"
 #include "WasmDebugServer.h"
 #include "WasmIPIntPlan.h"
 #include "WasmInstanceAnchor.h"
@@ -115,13 +116,64 @@ Ref<CalleeGroup> Module::compileSync(VM& vm, MemoryMode mode)
 {
     Ref<CalleeGroup> calleeGroup = getOrCreateCalleeGroup(vm, mode);
     calleeGroup->waitUntilFinished();
+    eagerlyCompileBBQ(vm, calleeGroup.get());
     return calleeGroup;
 }
 
 void Module::compileAsync(VM& vm, MemoryMode mode, CalleeGroup::AsyncCompilationCallback&& task)
 {
     Ref<CalleeGroup> calleeGroup = getOrCreateCalleeGroup(vm, mode);
-    calleeGroup->compileAsync(vm, WTF::move(task));
+    Ref protectedThis { *this };
+    calleeGroup->compileAsync(vm, createSharedTask<CalleeGroup::CallbackType>([this, protectedThis = WTF::move(protectedThis), task = WTF::move(task), &vm] (Ref<CalleeGroup>&& compiledGroup, bool isAsync) mutable {
+        eagerlyCompileBBQ(vm, compiledGroup.get());
+        task->run(WTF::move(compiledGroup), isAsync);
+    }));
+}
+
+void Module::eagerlyCompileBBQ(VM& vm, CalleeGroup& calleeGroup)
+{
+#if ENABLE(WEBASSEMBLY_BBQJIT)
+    if (!Options::useEagerBBQCompilation() || !calleeGroup.runnable())
+        return;
+
+    Locker eagerLocker { m_eagerCompilationLock };
+    for (uint32_t rawIndex = 0; rawIndex < moduleInformation().internalFunctionCount(); ++rawIndex) {
+        FunctionCodeIndex functionIndex { rawIndex };
+        if (calleeGroup.tryGetReplacementConcurrently(functionIndex))
+            continue;
+
+        Ref<IPIntCallee> profiledCallee = ipintCallees().at(rawIndex);
+        if (!BBQPlan::ensureGlobalBBQAllowlist().containsWasmFunction(functionIndex)
+            || !Options::wasmFunctionIndexRangeToCompile().isInRange(functionIndex)) {
+            calleeGroup.failEagerCompilation(makeString("BBQ compilation is disabled for Wasm function "_s, rawIndex));
+            return;
+        }
+
+        {
+            Locker locker { profiledCallee->tierUpCounter().m_lock };
+            auto status = profiledCallee->tierUpCounter().compilationStatus(calleeGroup.mode());
+            if (status == IPIntTierUpCounter::CompilationStatus::Compiled)
+                continue;
+            if (status != IPIntTierUpCounter::CompilationStatus::NotCompiled) {
+                calleeGroup.failEagerCompilation(makeString("Wasm function "_s, rawIndex, " is already being compiled"_s));
+                return;
+            }
+            profiledCallee->tierUpCounter().setCompilationStatus(calleeGroup.mode(), IPIntTierUpCounter::CompilationStatus::Compiling);
+        }
+
+        Ref<BBQPlan> plan = BBQPlan::create(vm, const_cast<ModuleInformation&>(moduleInformation()), functionIndex,
+            WTF::move(profiledCallee), Ref { *this }, Ref { calleeGroup }, Plan::dontFinalize());
+        plan->work();
+        if (plan->failed()) {
+            calleeGroup.failEagerCompilation(makeString("eager BBQ compilation failed for Wasm function "_s,
+                rawIndex, ": "_s, plan->errorMessage()));
+            return;
+        }
+    }
+#else
+    if (Options::useEagerBBQCompilation())
+        calleeGroup.failEagerCompilation("eager BBQ compilation requires the BBQ JIT"_s);
+#endif
 }
 
 void Module::copyInitialCalleeGroupToAllMemoryModes(MemoryMode initialMode)
