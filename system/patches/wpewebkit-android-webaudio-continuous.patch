From 729e504701912154d31a40e9c59c72e0bad716c5 Mon Sep 17 00:00:00 2001
From: OOS <oos@example.invalid>
Date: Thu, 30 Jul 2026 23:30:00 +0800
Subject: [PATCH] WPE: keep Android WebAudio buffers in the normal stream

Keep silent buffers in the normal Android stream, retain the GAP optimization
on other platforms, and map buffers with write access because WebCore renders
samples directly into them. Optional OOS_TRACE_WEBAUDIO logging reports actual
audible output bursts without affecting normal builds. Use 40 ms OpenSL
segments and a 200 ms ring buffer on Android so legacy device callbacks have
enough time to refill the queue without interrupting short sounds.
---
diff --git a/Source/WebCore/platform/audio/gstreamer/AudioDestinationGStreamer.cpp b/Source/WebCore/platform/audio/gstreamer/AudioDestinationGStreamer.cpp
index 881497d588..af86f9e271 100644
--- a/Source/WebCore/platform/audio/gstreamer/AudioDestinationGStreamer.cpp
+++ b/Source/WebCore/platform/audio/gstreamer/AudioDestinationGStreamer.cpp
@@ -167,8 +167,17 @@ void AudioDestinationGStreamer::initializePipeline()
     auto nameView = StringView::fromLatin1(GST_OBJECT_NAME(audioSink.get()));
     if (nameView.startsWith("autoaudiosink"_s)) {
         g_signal_connect(audioSink.get(), "child-added", G_CALLBACK(+[](GstChildProxy*, GObject* object, gchar*, gpointer) {
-            if (GST_IS_AUDIO_BASE_SINK(object))
+            if (GST_IS_AUDIO_BASE_SINK(object)) {
+#if OS(ANDROID)
+                // OpenSL invokes GStreamer's feeder from the device callback.
+                // Older Android devices need a longer segment so one delayed
+                // callback cannot interrupt or discard short WebAudio sounds.
+                g_object_set(GST_AUDIO_BASE_SINK(object), "buffer-time", static_cast<gint64>(200000),
+                    "latency-time", static_cast<gint64>(40000), nullptr);
+#else
                 g_object_set(GST_AUDIO_BASE_SINK(object), "buffer-time", static_cast<gint64>(100000), nullptr);
+#endif
+            }
         }), nullptr);
 
         // Autoaudiosink does the real sink detection in the GST_STATE_NULL->READY transition
diff --git a/Source/WebCore/platform/audio/gstreamer/WebKitWebAudioSourceGStreamer.cpp b/Source/WebCore/platform/audio/gstreamer/WebKitWebAudioSourceGStreamer.cpp
index 407d1cb591..2b7880375e 100644
--- a/Source/WebCore/platform/audio/gstreamer/WebKitWebAudioSourceGStreamer.cpp
+++ b/Source/WebCore/platform/audio/gstreamer/WebKitWebAudioSourceGStreamer.cpp
@@ -39,6 +39,9 @@
 #include <wtf/glib/GUniquePtr.h>
 #include <wtf/glib/WTFGType.h>
 
+#include <algorithm>
+#include <cmath>
+
 using namespace WebCore;
 
 typedef struct _WebKitWebAudioSrcClass   WebKitWebAudioSrcClass;
@@ -82,6 +85,11 @@ struct _WebKitWebAudioSrcPrivate {
 
     bool hasRenderedAudibleFrame { false };
 
+    bool traceOutput { false };
+    bool traceAudible { false };
+    guint64 traceBurstCount { 0 };
+    guint64 traceBurstFrames { 0 };
+
     Lock dispatchToRenderThreadLock;
     Function<void(Function<void()>&&)> dispatchToRenderThreadFunction WTF_GUARDED_BY_LOCK(dispatchToRenderThreadLock);
 
@@ -93,6 +101,7 @@ struct _WebKitWebAudioSrcPrivate {
     {
         sourcePad = webkitGstGhostPadFromStaticTemplate(&webAudioSrcTemplate, "src"_s, nullptr);
 
+        traceOutput = !!g_getenv("OOS_TRACE_WEBAUDIO");
         g_rec_mutex_init(&mutex);
     }
 
@@ -229,7 +238,7 @@ static GRefPtr<GstBuffer> webKitWebAudioSrcAllocateBuffer(WebKitWebAudioSrc* src
     gst_buffer_add_audio_meta(buffer.get(), &priv->info, priv->framesToPull, nullptr);
 
     {
-        GstMappedBuffer mappedBuffer(buffer.get(), GST_MAP_READ);
+        GstMappedBuffer mappedBuffer(buffer.get(), GST_MAP_WRITE);
         ASSERT(mappedBuffer);
         const auto& bus = destination->renderBus();
         for (unsigned channelIndex = 0; channelIndex < bus->numberOfChannels(); channelIndex++)
@@ -275,6 +284,29 @@ static void webKitWebAudioSrcRenderAndPushFrames(const GRefPtr<GstElement>& elem
     if (bus) [[likely]]
         destination->callRenderCallback(*bus, priv->framesToPull, outputTimestamp);
 
+    if (priv->traceOutput) {
+        float peak = 0;
+        for (unsigned channelIndex = 0; channelIndex < bus->numberOfChannels(); ++channelIndex) {
+            for (float sample : bus->channel(channelIndex)->span())
+                peak = std::max(peak, std::abs(sample));
+        }
+        constexpr float audibleThreshold = 1e-6f;
+        bool audible = peak > audibleThreshold;
+        if (audible) {
+            if (!priv->traceAudible) {
+                ++priv->traceBurstCount;
+                priv->traceBurstFrames = 0;
+                g_printerr("OOS WebAudio output burst=%" G_GUINT64_FORMAT " start-frame=%" G_GUINT64_FORMAT " peak=%g\n",
+                    priv->traceBurstCount, priv->numberOfSamples - priv->framesToPull, peak);
+            }
+            priv->traceBurstFrames += priv->framesToPull;
+        } else if (priv->traceAudible) {
+            g_printerr("OOS WebAudio output burst=%" G_GUINT64_FORMAT " end frames=%" G_GUINT64_FORMAT "\n",
+                priv->traceBurstCount, priv->traceBurstFrames);
+        }
+        priv->traceAudible = audible;
+    }
+
     if (!priv->hasRenderedAudibleFrame && !bus->isSilent()) {
         destination->notifyIsPlaying(true);
         priv->hasRenderedAudibleFrame = true;
@@ -283,6 +315,7 @@ static void webKitWebAudioSrcRenderAndPushFrames(const GRefPtr<GstElement>& elem
     GST_BUFFER_TIMESTAMP(buffer.get()) = timestamp;
     GST_BUFFER_DURATION(buffer.get()) = duration;
 
+#if !OS(ANDROID)
     if (bus->isSilent()) {
         auto& quirksManager = GStreamerQuirksManager::singleton();
         if (quirksManager.isEnabled())
@@ -292,6 +325,7 @@ static void webKitWebAudioSrcRenderAndPushFrames(const GRefPtr<GstElement>& elem
             GST_BUFFER_FLAG_SET(buffer.get(), GST_BUFFER_FLAG_DROPPABLE);
         }
     }
+#endif
 
     if (priv->runningTimeReset) {
         priv->runningTimeReset = false;
