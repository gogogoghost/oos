From 2fda0fa2147a1dc06b17e83c3beb8ee7d307bcc0 Mon Sep 17 00:00:00 2001
From: OOS <oos@example.invalid>
Date: Wed, 29 Jul 2026 23:00:00 +0800
Subject: [PATCH] WPEBackend Android: fix renderer IPC ordering and affinity

The renderer protocol sends fixed-size control messages and separate one-byte
SCM_RIGHTS messages. SOCK_STREAM does not preserve those boundaries, while the
receivers discard any short control read. One short read therefore loses a
FrameComplete or ReleaseBuffer permanently.

The backend also sends those replies through the RendererBackend channel,
whose GLib source runs on the WebProcess main thread. libwpe invokes WebKit's
frame-complete callback synchronously, but ThreadedCompositor requires it on
its own run loop. Under sustained updates the main-thread callback can clear
the next render target while the compositor is painting it, leaving WebKit in
the InProgress state forever.

Use SOCK_SEQPACKET and route per-target replies through the EGLTarget channel,
which is attached to the compositor thread's context. Track the last committed
pool per ViewBackend instead of using the process-global pool ID.

---

diff --git a/src/ipc.cpp b/src/ipc.cpp
index 667241f..50acc68 100644
--- a/src/ipc.cpp
+++ b/src/ipc.cpp
@@ -34,7 +34,7 @@ void Host::initialize(Handler& handler)
     m_handler = &handler;
 
     int sockets[2];
-    int ret = socketpair(AF_UNIX, SOCK_STREAM, 0, sockets);
+    int ret = socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets);
     if (ret == -1)
         return;
 
@@ -136,13 +136,17 @@ gboolean Host::socketCallback(GSocket* socket, GIOCondition condition, gpointer
         nullptr, nullptr, nullptr, nullptr, nullptr);
 
     // If nothing is read, give up.
-    if (len == -1) {
+    if (len <= 0) {
         g_free(buffer);
         return FALSE;
     }
 
-    if (len == Message::size)
-        host.m_handler->handleMessage(buffer, Message::size);
+    if (len != Message::size) {
+        g_warning("WPEBackend Android host received an invalid IPC packet: %zd bytes, expected %zu", len, Message::size);
+        g_free(buffer);
+        return FALSE;
+    }
+    host.m_handler->handleMessage(buffer, Message::size);
 
     g_free(buffer);
     return TRUE;
@@ -198,8 +202,13 @@ gboolean Client::socketCallback(GSocket* socket, GIOCondition condition, gpointe
         return FALSE;
     }
 
-    auto client = reinterpret_cast<Client*>(data);
-    if (len == Message::size && client->m_handler)
+    if (len != Message::size) {
+        g_warning("WPEBackend Android client received an invalid IPC packet: %zd bytes, expected %zu", len, Message::size);
+        g_free(buffer);
+        return FALSE;
+    }
+    auto* client = reinterpret_cast<Client*>(data);
+    if (client->m_handler)
         client->m_handler->handleMessage(buffer, Message::size);
 
     g_free(buffer);
diff --git a/src/renderer-backend-egl.cpp b/src/renderer-backend-egl.cpp
index 943113c..124ca08 100644
--- a/src/renderer-backend-egl.cpp
+++ b/src/renderer-backend-egl.cpp
@@ -456,7 +456,28 @@ void EGLTarget::releaseBuffer(uint32_t poolID, uint32_t bufferID)
 
 void EGLTarget::handleMessage(char* data, size_t size)
 {
-    // TODO:
+    if (size != IPC::Message::size)
+        return;
+
+    auto& message = IPC::Message::cast(data);
+    switch (message.messageCode) {
+    case IPC::FrameComplete::code: {
+        auto frameComplete = IPC::FrameComplete::from(message);
+        ALOGV("EGLTarget::handleMessage(): FrameComplete { poolID %u }", frameComplete.poolID);
+        if (frameComplete.poolID == buffers.poolID)
+            wpe_renderer_backend_egl_target_dispatch_frame_complete(target);
+        break;
+    }
+    case IPC::ReleaseBuffer::code: {
+        auto release = IPC::ReleaseBuffer::from(message);
+        ALOGV("EGLTarget::handleMessage(): BufferRelease { poolID %u, bufferID %u }", release.poolID, release.bufferID);
+        releaseBuffer(release.poolID, release.bufferID);
+        break;
+    }
+    default:
+        ALOGW("EGLTarget received invalid IPC message code=%" PRIu64, message.messageCode);
+        break;
+    }
 }
 
 struct wpe_renderer_backend_egl_interface android_renderer_backend_egl_impl = {
diff --git a/src/renderer-host-private.h b/src/renderer-host-private.h
index 408ea7d..1575604 100644
--- a/src/renderer-host-private.h
+++ b/src/renderer-host-private.h
@@ -96,8 +96,6 @@ public:
     ViewBackend* findViewBackend(uint32_t);
 
     void releaseBuffer(Buffer* buffer);
-    void frameComplete();
-
 private:
 
     // (poolId -> BufferPool)
diff --git a/src/renderer-host.cpp b/src/renderer-host.cpp
index 39f2788..4c811f7 100644
--- a/src/renderer-host.cpp
+++ b/src/renderer-host.cpp
@@ -32,8 +32,6 @@
 
 namespace WPEAndroid {
 
-uint32_t m_lastExportedPoolID = 0;
-
 class RendererHostClientProxy final : public IPC::Host::Handler {
 public:
     RendererHostClientProxy(RendererHost& host);
@@ -151,26 +149,6 @@ void RendererHost::releaseBuffer(Buffer* buffer) {
         return;
     }
 
-    auto* bufferPool = findBufferPool(buffer->poolID());
-
-    IPC::ReleaseBuffer release;
-    release.poolID = buffer->poolID();
-    release.bufferID = buffer->bufferID();
-
-    IPC::Message message;
-    IPC::ReleaseBuffer::construct(message, release);
-    bufferPool->client()->ipc().sendMessage(IPC::Message::data(message), IPC::Message::size);
-}
-
-void RendererHost::frameComplete() {
-    auto* bufferPool = findBufferPool(m_lastExportedPoolID);
-
-    IPC::FrameComplete frameComplete;
-    frameComplete.poolID = m_lastExportedPoolID;
-
-    IPC::Message message;
-    IPC::FrameComplete::construct(message, frameComplete);
-    bufferPool->client()->ipc().sendMessage(IPC::Message::data(message), IPC::Message::size);
 }
 
 // RendereHostClientProxy
@@ -243,14 +221,11 @@ void RendererHostClientProxy::bufferCommit(uint32_t poolID, uint32_t bufferID, i
 
     auto* buffer = bufferPool->getBuffer(bufferID);
 
-    // TODO: This is only temprorary solution for PSON support. To make this work correctly
-    // interface change is needed where we received pool id from frame complete callback.
-    m_lastExportedPoolID = poolID;
-
     auto* viewBackend = m_host.findViewBackend(poolID);
     if (viewBackend) {
         auto* androidBackend = viewBackend->androidBackend();
         if (androidBackend) {
+            viewBackend->didCommitBuffer(poolID);
             buffer->setLocked(true);
             androidBackend->commitBuffer(buffer, fenceFD);
         }
diff --git a/src/view-backend-private.h b/src/view-backend-private.h
index 64b029d..fe6874c 100644
--- a/src/view-backend-private.h
+++ b/src/view-backend-private.h
@@ -75,6 +75,11 @@ public:
 
     void frameComplete();
     void releaseBuffer(Buffer*);
+    void didCommitBuffer(uint32_t poolId)
+    {
+        m_lastCommittedPoolId = poolId;
+        m_hasCommittedPool = true;
+    }
 
 private:
 
@@ -90,6 +95,8 @@ private:
     IPC::Host m_ipcHost;
 
     std::vector<uint32_t> m_poolIds;
+    uint32_t m_lastCommittedPoolId { 0 };
+    bool m_hasCommittedPool { false };
 };
 
 } // namespace WPEAndroid
diff --git a/src/view-backend.cpp b/src/view-backend.cpp
index 7043f1e..020a636 100644
--- a/src/view-backend.cpp
+++ b/src/view-backend.cpp
@@ -78,15 +78,26 @@ void ViewBackend::initialize()
 
 void ViewBackend::frameComplete()
 {
-    // Assume that last released buffer is from the completed frame
-    RendererHost::instance().frameComplete();
+    if (m_hasCommittedPool) {
+        IPC::FrameComplete frameComplete;
+        frameComplete.poolID = m_lastCommittedPoolId;
+        IPC::Message message;
+        IPC::FrameComplete::construct(message, frameComplete);
+        m_ipcHost.sendMessage(IPC::Message::data(message), IPC::Message::size);
+    }
 
     wpe_view_backend_dispatch_frame_displayed(wpeBackend());
 }
 
 void ViewBackend::releaseBuffer(Buffer* buffer)
 {
+    IPC::ReleaseBuffer release;
+    release.poolID = buffer->poolID();
+    release.bufferID = buffer->bufferID();
     RendererHost::instance().releaseBuffer(buffer);
+    IPC::Message message;
+    IPC::ReleaseBuffer::construct(message, release);
+    m_ipcHost.sendMessage(IPC::Message::data(message), IPC::Message::size);
 }
 
 void ViewBackend::registerPool(uint32_t poolId)
