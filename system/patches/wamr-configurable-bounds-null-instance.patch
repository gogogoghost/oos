diff --git a/core/iwasm/common/wasm_runtime_common.c b/core/iwasm/common/wasm_runtime_common.c
index e38d03e..d36ddae 100644
--- a/core/iwasm/common/wasm_runtime_common.c
+++ b/core/iwasm/common/wasm_runtime_common.c
@@ -3290,22 +3290,35 @@ wasm_runtime_set_bounds_checks(WASMModuleInstanceCommon *module_inst,
 bool
 wasm_runtime_is_bounds_checks_enabled(WASMModuleInstanceCommon *module_inst)
 {
+    if (!module_inst) {
+        return true;
+    }
 
 #if WASM_ENABLE_INTERP != 0
     if (module_inst->module_type == Wasm_Module_Bytecode) {
-        return !((WASMModuleInstanceExtra *)((WASMModuleInstance *)module_inst)
-                     ->e)
-                    ->common.disable_bounds_checks;
+        WASMModuleInstanceExtra *instance_extra =
+            (WASMModuleInstanceExtra *)((WASMModuleInstance *)module_inst)->e;
+
+        /* The fast-interpreter loader uses a zeroed placeholder instance
+           while constructing its dispatch table. */
+        if (!instance_extra) {
+            return true;
+        }
+        return !instance_extra->common.disable_bounds_checks;
     }
 #endif
 
 #if WASM_ENABLE_AOT != 0
     if (module_inst->module_type == Wasm_Module_AoT) {
-        return !((AOTModuleInstanceExtra *)((WASMModuleInstance *)module_inst)
-                     ->e)
-                    ->common.disable_bounds_checks;
+        AOTModuleInstanceExtra *instance_extra =
+            (AOTModuleInstanceExtra *)((AOTModuleInstance *)module_inst)->e;
+
+        if (!instance_extra) {
+            return true;
+        }
+        return !instance_extra->common.disable_bounds_checks;
     }
 #endif
 
     return true;
 }
