# Keep each device sysroot separate. The configure script selects one from the
# device name passed on its command line.
NOKIA_2780_SYSTEM_DIR=/path/to/nokia-2780/extracted/system
NOKIA_8110_SYSTEM_DIR=/path/to/nokia-8110/extracted/system

# Android NDK used to build and strip the native OOS executable.
ANDROID_NDK=/home/jax/Android/Sdk/ndk/r21e

# Optional: WAMR builds locally by default. Use a separate container only when
# the host cannot provide a compatible LLVM (LLVM 14 is recommended).
# OOS_WAMR_DISTROBOX=oos-debian12
# OOS_LLVM_CONFIG=/usr/bin/llvm-config-14
