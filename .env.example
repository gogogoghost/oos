# Keep each device sysroot separate. The configure script selects one from the
# device name passed on its command line.
NOKIA_2780_SYSTEM_DIR=/path/to/nokia-2780/extracted/system
NOKIA_8110_SYSTEM_DIR=/path/to/nokia-8110/extracted/system

# Android NDK used by the isolated WPE Android ARMv7 profiles.
WPE_NDK=/home/jax/Android/Sdk/ndk/magisk

# Optional: run WPE/Cerbero compilation in this Distrobox. Res packaging also
# uses patchelf from this container when it is unavailable on the host.
# WPE_DISTROBOX=oos-debian12

# Optional built-in KaiOS 3 test application copied into each res package.
# OOS_BUILTIN_KAIOS3_APP_ID=omnij2me
# OOS_BUILTIN_KAIOS3_PACKAGE=/path/to/application.zip
# Optional publishing-time AOT cache. Files are looked up by raw Wasm SHA-256.
# OOS_BUILTIN_KAIOS3_AOT_CACHE=/path/to/webassembly-aot

# Optional: WAMR builds locally by default. Use a separate container only when
# the host cannot provide a compatible LLVM (LLVM 14 is recommended).
# OOS_WAMR_DISTROBOX=oos-debian12
# OOS_LLVM_CONFIG=/usr/bin/llvm-config-14
# Trusted-app benchmark only: specialize AOT for the device CPU and remove
# Wasm memory/stack bounds checks. Out-of-bounds Wasm can corrupt the host.
# OOS_WAMR_WEB_UNSAFE_FAST=ON
