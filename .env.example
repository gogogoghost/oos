# Absolute path to the extracted Android /system directory for the active device.
SYSTEM_DIR=/path/to/extracted/system

# Android NDK used by the WPE Android API-29 ARMv7 build.
WPE_NDK=/home/jax/Android/Sdk/ndk/magisk

# Optional: run WPE/Cerbero compilation in this Distrobox.
# WPE_DISTROBOX=oos-debian12

# Keep the unsupported concurrent fb1 experiment disabled. The Nokia 2780
# vendor driver cannot keep fb0 and fb1 active together.
# OOS_ENABLE_COVER=0
