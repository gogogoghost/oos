# Local configuration
.env

# Generated code and build outputs
/build/
/build-*/
/generated/
/dist/
/apps/target/
/target/
/system/build/
/system/third_party/
/oom

# Device dumps, images, traces, and extracted system artifacts
/artifacts/
/system-stock/
/system-stock.img
*.img
*.trace

# External source checkouts retain their own repositories and are not vendored.
/third_party/*
!/third_party/README.md
!/third_party/versions.env

# Local agent state
/.agents/
/.codex/
/.wrangler/
