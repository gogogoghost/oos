OOS_WPE_PROFILE=android23-armv7-jit
OOS_WPE_ANDROID_API=23
OOS_WPE_CERBERO_CONFIG=config/cerbero/kaios-android23-armv7.cbc
OOS_WPE_SOURCE_KEY=android23-armv7-jit
OOS_WPE_SYSROOT_KEY=nokia-8110-4g
OOS_WPE_BUFFER_ABI=gralloc0-native-handle
OOS_WPE_DISPLAY_BACKEND=hwc1
OOS_WPE_BACKEND_PATCH=patches/wpebackend-android-gralloc0.patch
# WebCore unified sources exceed practical memory limits at 32 concurrent
# compilers even with swap. Callers may override this with WPE_BUILD_JOBS.
OOS_WPE_DEFAULT_JOBS=8
